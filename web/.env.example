# 复制此文件为 .env，填入你的 API Key
# 注册教程见 README.md → "API 配置"

# ── 阿里云 DashScope（VL 识别 & 补充搜索）───────────────────
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_REALTIME_STT_MODEL=paraformer-realtime-v2

# ── 聊天模型（二选一）────────────────────────────────────────
# 方案 A：阿里云 Qwen（默认）
QWEN_CHAT_MODEL=qwen-turbo
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 方案 B：字节火山引擎 Seed-Character（角色扮演更稳定）
# 注册：https://console.volcengine.com → 模型推理 → 开通 Seed-Character
# VOLC_API_KEY=your_volc_api_key_here
# QWEN_CHAT_MODEL=character-pro（或 character-lite，按控制台实际模型 ID 填写）
# CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── Microsoft Azure Speech-to-Text（硬件语音识别）───────────
# 浏览器端使用 Web Speech API，不需要此 Key
# 注册：https://portal.azure.com → 创建"语音服务"资源 → 密钥和终结点
# 免费层：每月 5 小时，无需信用卡
AZURE_STT_KEY=your_azure_stt_key_here
AZURE_STT_REGION=eastasia   # 就近区域：eastasia / eastus / westeurope

# ── 对话历史 ─────────────────────────────────────────────────
MAX_HISTORY_TURNS=10   # 每个角色最多保留 N 轮对话（1轮=1问1答）

# ── 服务器 ───────────────────────────────────────────────────
PORT=3000

# ── 角色识别：VL 模型（图片理解，单次返回完整角色信息）────────
# 填入你的模型 ID，如 qwen-vl-max / qwen2.5-vl-72b-instruct 等
QWEN_VL_MODEL=qwen-vl-max

# ── 角色识别：补充搜索模型（当 VL 信息不完整时启用联网搜索）──
QWEN_SEARCH_MODEL=qwen-plus
